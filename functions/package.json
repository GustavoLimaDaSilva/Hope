{
  "name": "functions",
  "type": "module",
  "scripts": {
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "compile": "tsc",
    "debug": "node --inspect node_modules/.bin/firebase-functions --source=lib/src/ --target=api",
    "watch": "concurrently \"npm run compile -- --watch\" \"nodemon --watch ./build/ --exec npm run debug\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/functions/src/index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.2",
    "@imagekit/nodejs": "^7.1.1",
    "@imagekit/react": "^5.0.1",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "express": "^5.1.0",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.1.1",
    "firebase-tools": "^15.10.0",
    "nodemon": "^3.1.10",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.0",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "globals": "^17.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.55.0"
  },
  "private": true
}
